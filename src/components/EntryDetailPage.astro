---
import { Icon } from "astro-icon/components";
import DetailPage from "@/components/DetailPage.astro";

interface Link {
  label: string;
  url: string;
  icon?: string;
}

interface EntryData {
  title: string;
  period: string;
  blurb: string;
  game?: string;
  theme?: string;
  tech?: string[];
  award?: string;
  image?: string;
  links?: Link[];
}

interface Props {
  entry: EntryData;
  mode: "ai" | "games";
  backPath: string;
  backLabel: string;
}

const { entry, mode, backPath, backLabel } = Astro.props;
---

<DetailPage
  title={entry.title}
  mode={mode}
  description={entry.blurb}
  backPath={backPath}
  backLabel={backLabel}
  meta={entry.period}
  image={entry.image}
  skills={entry.tech}
  links={entry.links}
>
  {entry.award && <p slot="metadata" class="award"><Icon name="carbon:trophy" size={16} aria-hidden="true" />{entry.award}</p>}
  {entry.game && <p slot="metadata" class="detail-subheading">{entry.game}</p>}
  {entry.theme && <p slot="metadata" class="theme">Theme: {entry.theme}</p>}
  <slot />
</DetailPage>
