---
/**
 * Page-open reveal. On every full page load the viewport is covered by a
 * canvas that renders the page as a low-resolution mosaic — starting from a
 * single giant "@" and doubling the grid resolution step by step until the
 * mosaic is char-sized, then dissolving cell-by-cell into the real page.
 *
 * AI mode draws the mosaic as ASCII characters; games mode draws it as
 * pixel-art pixels. Both use identical grid dimensions and timing, so the
 * two intros (and the pages behind them) line up with each other.
 *
 * While it runs, <html class="intro"> keeps the real page hidden
 * (see global.css). Skipped for reduced motion / no JS.
 */
---

<script>
  import {
    buildDensityMap,
    densityChar,
    densityColor,
    drawAsciiCell,
    drawPixelCell,
    makeOverlayCanvas,
    sampleMap,
  } from "@/scripts/fx";

  const html = document.documentElement;
  const finish = () => html.classList.remove("intro");

  const run = async () => {
    if (!html.classList.contains("intro")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return finish();

    // Play once per browsing session — later full loads (reloads, cross-mode
    // navigations that fall back to a hard load) skip straight to the page.
    try {
      if (sessionStorage.getItem("introPlayed") === "1") return finish();
      sessionStorage.setItem("introPlayed", "1");
    } catch {}

    // Give the display fonts a beat to load so canvas glyphs match the site.
    await Promise.race([document.fonts?.ready, new Promise((r) => setTimeout(r, 350))]);

    const w = window.innerWidth;
    const h = window.innerHeight;
    const mode = html.dataset.mode === "games" ? "games" : "ai";
    const [canvas, ctx] = makeOverlayCanvas();
    document.body.appendChild(canvas);

    // High-res rasterization of the page layout, sampled at every step.
    const HI_COLS = 144;
    const HI_ROWS = Math.max(2, Math.round((HI_COLS * h) / w));
    const density = buildDensityMap(HI_COLS, HI_ROWS);

    // Resolution steps: 1 cell, then ~1.5× column counts until cells reach
    // character size (~11px). Many small jumps in quick succession keep the
    // growth reading as one continuous sharpening. Same steps in both modes.
    const steps = [1];
    for (let c = 2; c <= w / 11; c = Math.max(c + 1, Math.round(c * 1.5))) steps.push(c);
    const stepTime = (i: number) => (i === 0 ? 420 : Math.max(85, 235 - i * 16));

    const paintStep = (cols: number) => {
      ctx.fillStyle = "#000000";
      ctx.fillRect(0, 0, w, h);

      if (cols === 1) {
        // The whole site compressed into one cell: a single giant character
        // in the terminal, a single dark cold pixel in games mode.
        if (mode === "games") {
          ctx.fillStyle = "#1d2b53";
          ctx.fillRect(0, 0, w, h);
          return;
        }
        ctx.fillStyle = "#ffffff";
        const size = Math.floor(Math.min(w, h) * 0.82);
        ctx.font = `${size}px VT323, monospace`;
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("@", w / 2, h / 2 + size * 0.05);
        return;
      }

      const cell = w / cols;
      const rows = Math.ceil(h / cell);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const d = sampleMap(density, HI_COLS, HI_ROWS, x / cols, (y * cell) / h, (x + 1) / cols, ((y + 1) * cell) / h);
          if (d <= 0.02) continue; // stays black
          const jd = d * (0.82 + Math.random() * 0.36); // shimmer
          if (mode === "ai") drawAsciiCell(ctx, x * cell, y * cell, cell, densityChar(jd));
          else drawPixelCell(ctx, x * cell, y * cell, cell, densityColor(jd));
        }
      }
    };

    // Walk the steps on a timer, then dissolve cell-by-cell.
    let i = 0;
    const next = () => {
      const cols = steps[i];
      if (cols === undefined) return dissolve();
      paintStep(cols);
      i++;
      setTimeout(next, stepTime(i - 1));
    };

    const dissolve = () => {
      finish(); // real page becomes visible underneath as cells clear
      const cols = steps[steps.length - 1] ?? 64;
      const cell = w / cols;
      const rows = Math.ceil(h / cell);
      const deadlines: number[] = [];
      for (let c = 0; c < cols * rows; c++) deadlines.push(Math.random() * 430);
      const start = performance.now();
      const tick = (now: number) => {
        const t = now - start;
        let alive = false;
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const dl = deadlines[y * cols + x] ?? 0;
            if (dl < 0) continue; // already cleared
            if (t >= dl) {
              ctx.clearRect(x * cell - 0.5, y * cell - 0.5, cell + 1, cell + 1);
              deadlines[y * cols + x] = -1;
            } else alive = true;
          }
        }
        if (alive) requestAnimationFrame(tick);
        else canvas.remove();
      };
      requestAnimationFrame(tick);
    };

    next();
  };

  run();
</script>
