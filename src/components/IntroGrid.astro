---
/**
 * Page-open reveal. On the first full load of a session the viewport is
 * covered by a canvas that renders the page as a low-resolution mosaic —
 * a single cell (giant "@" in AI mode, dark-blue pixel in games mode)
 * refining step by step at constant speed until the mosaic is char-sized.
 *
 * The reveal is interleaved with the refinement: from near the beginning,
 * cells start dropping out to expose the real page underneath — slowly at
 * first, ramping up as the grid sharpens — driven by a deterministic
 * per-position mask so a revealed spot stays revealed across steps. The
 * final phase just completes the mask.
 *
 * AI mode draws the mosaic as ASCII characters; games mode draws it as
 * pixel-art pixels. Both use identical grid dimensions and timing.
 * While it runs, <html class="intro"> keeps the real page hidden
 * (see global.css). Skipped for reduced motion / no JS.
 */
---

<script>
  import {
    buildDensityMap,
    densityChar,
    densityColor,
    drawAsciiCell,
    drawPixelCell,
    lockScroll,
    makeOverlayCanvas,
    sampleMap,
  } from "@/scripts/fx";

  const html = document.documentElement;
  const finish = () => html.classList.remove("intro");

  const run = () => {
    if (!html.classList.contains("intro")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return finish();

    // Play once per browsing session — later full loads (reloads, cross-mode
    // navigations that fall back to a hard load) skip straight to the page.
    try {
      if (sessionStorage.getItem("introPlayed") === "1") return finish();
      sessionStorage.setItem("introPlayed", "1");
    } catch {}

    const w = window.innerWidth;
    const h = window.innerHeight;
    const mode = html.dataset.mode === "games" ? "games" : "ai";
    const [canvas, ctx] = makeOverlayCanvas();
    html.appendChild(canvas); // on <html>, so a body swap can't tear it down
    const unlockScroll = lockScroll();

    // High-res rasterization of the page layout, sampled at every step.
    const HI_COLS = 144;
    const HI_ROWS = Math.max(2, Math.round((HI_COLS * h) / w));
    const density = buildDensityMap(HI_COLS, HI_ROWS);

    // Resolution steps: 1 cell, then ~1.5× column counts until cells reach
    // character size (~11px). Constant, top-speed pacing throughout.
    const steps = [1];
    for (let c = 2; c <= w / 11; c = Math.max(c + 1, Math.round(c * 1.5))) steps.push(c);
    const STEP_MS = 60;
    const GRID_END = 110 + (steps.length - 1) * STEP_MS;
    const GRID_REVEAL = 0.45; // reveal fraction reached by the last step

    // ── Reveal mask ──────────────────────────────────────────────────────
    // Deterministic threshold per 24px block of the viewport: a block is
    // revealed once the global reveal fraction passes its threshold, so
    // holes persist as the grid resolution changes underneath them.
    const threshold = (px: number, py: number) => {
      const s = Math.sin(Math.floor(px / 24) * 127.1 + Math.floor(py / 24) * 311.7) * 43758.5453;
      return s - Math.floor(s);
    };
    // 0 → GRID_REVEAL over the grid phase: quadratic, so it creeps in
    // near the beginning and ramps up toward the end.
    const start = performance.now();
    const reveal = () => {
      const u = Math.min(1, Math.max(0, (performance.now() - start - 110) / (GRID_END - 110)));
      return GRID_REVEAL * u * u;
    };

    const paintStep = (cols: number) => {
      if (cols === 1) {
        // The whole site compressed into one cell: a single giant character
        // in the terminal, a single dark cold pixel in games mode.
        ctx.fillStyle = mode === "games" ? "#1d2b53" : "#000000";
        ctx.fillRect(0, 0, w, h);
        if (mode === "ai") {
          ctx.fillStyle = "#ffffff";
          const size = Math.floor(Math.min(w, h) * 0.82);
          ctx.font = `${size}px VT323, monospace`;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText("@", w / 2, h / 2 + size * 0.05);
        }
        return;
      }

      const r = reveal();
      const cell = w / cols;
      const rows = Math.ceil(h / cell);
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const cx = x * cell;
          const cy = y * cell;
          if (threshold(cx + cell / 2, cy + cell / 2) < r) {
            ctx.clearRect(cx - 0.5, cy - 0.5, cell + 1, cell + 1); // revealed
            continue;
          }
          const d = sampleMap(density, HI_COLS, HI_ROWS, x / cols, cy / h, (x + 1) / cols, (cy + cell) / h);
          if (d <= 0.02) {
            ctx.fillStyle = "#000000";
            ctx.fillRect(cx, cy, cell + 0.5, cell + 0.5);
            continue;
          }
          const jd = d * (0.82 + Math.random() * 0.36); // shimmer
          if (mode === "ai") drawAsciiCell(ctx, cx, cy, cell, densityChar(jd));
          else drawPixelCell(ctx, cx, cy, cell, densityColor(jd));
        }
      }
    };

    // Walk the steps on a constant clock, then complete the reveal.
    let i = 0;
    const next = () => {
      const cols = steps[i];
      if (cols === undefined) return completeReveal();
      paintStep(cols);
      if (i === 0) finish(); // real page becomes visible under the holes
      i++;
      setTimeout(next, i === 1 ? 110 : STEP_MS);
    };

    const completeReveal = () => {
      const cols = steps[steps.length - 1] ?? 64;
      const cell = w / cols;
      const rows = Math.ceil(h / cell);
      const cleared = new Uint8Array(cols * rows);
      const t0 = performance.now();
      const DUR = 260;
      const tick = (now: number) => {
        const r = GRID_REVEAL + (1.001 - GRID_REVEAL) * Math.min(1, (now - t0) / DUR);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const idx = y * cols + x;
            if (cleared[idx]) continue;
            if (threshold(x * cell + cell / 2, y * cell + cell / 2) < r) {
              ctx.clearRect(x * cell - 0.5, y * cell - 0.5, cell + 1, cell + 1);
              cleared[idx] = 1;
            }
          }
        }
        if (now - t0 < DUR) requestAnimationFrame(tick);
        else {
          canvas.remove();
          unlockScroll();
        }
      };
      requestAnimationFrame(tick);
    };

    next();
  };

  run();
</script>
