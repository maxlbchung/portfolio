---
import { Icon } from "astro-icon/components";
import { imagePath } from "@/lib/url";

interface Props {
  title: string;
  period?: string;
  blurb?: string;
  tech?: string[];
  award?: string;
  image?: string;
  href: string;
}

const { title, period, blurb, tech = [], award, image, href } = Astro.props;
const imageSrc = image && imagePath(image);
---

<a class="card entry preview" href={href} data-detail-link>
  <div class="preview-media">
    {imageSrc && <img src={imageSrc} alt="" loading="lazy" />}
  </div>
  <div class="preview-content">
    <div class="head">
      <h2>{title}</h2>
      {period && <span class="muted period">{period}</span>}
    </div>
    {award && <p class="award"><Icon name="carbon:trophy" size={16} aria-hidden="true" /><span>{award}</span></p>}
    {blurb && <p class="blurb">{blurb}</p>}
    {tech.length > 0 && <div class="tech">{tech.map((t) => <span class="chip">{t}</span>)}</div>}
  </div>
</a>

<style>
  .entry { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem 1.4rem; }
  .preview { color: var(--text); transition: border-color var(--transition-quick), transform var(--transition-quick); }
  .preview:hover { border-color: var(--text); transform: translateY(-2px); }
  .preview-media { align-self: stretch; background: var(--surface); min-height: 10rem; overflow: hidden; position: relative; }
  .preview-media img { display: block; height: 100%; inset: 0; object-fit: cover; position: absolute; width: 100%; }
  .preview-content { border-left: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.65rem; margin-block: -1.25rem; min-width: 0; padding: 1.25rem 0 1.25rem 1rem; }
  html[data-mode="games"] .preview-content { border-left-width: 3px; }

  .head {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
  }

  h2 {
    font-size: calc(1.25rem * var(--display-scale, 1));
  }

  .period {
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .award {
    align-items: center;
    color: var(--accent);
    display: flex;
    font-size: 0.9rem;
    gap: 0.4rem;
  }

  .blurb { margin: 0; }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.55rem;
    margin-top: auto;
  }

  .preview:hover h2::after { content: " «"; }
  @media (max-width: 700px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }

    .preview-media {
      aspect-ratio: 1;
      min-height: 0;
      width: min(100%, 10rem);
      justify-self: center;
    }

    .preview-content {
      border-left: 0;
      border-top: 1px solid var(--border);
      margin: 0 -1.4rem;
      padding: 1rem 1.4rem 0;
    }

    html[data-mode="games"] .preview-content {
      border-left-width: 0;
      border-top-width: 3px;
    }
  }
</style>
