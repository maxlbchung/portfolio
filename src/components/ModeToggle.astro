---
import { Icon } from "astro-icon/components";

/**
 * The big AI ⇄ GAMES switch on the home page — the original full-size
 * two-sided toggle, stylized per mode: an ASCII terminal box with a
 * bracketed inverse-video thumb in AI mode, a chunky pixel-art slab in
 * games mode. Flipping a side dispatches `libo:modeswap`;
 * ModeSweep.astro runs the conversion wave and swaps html[data-mode]
 * under it (the thumb glides when the attribute changes).
 */
---

<div class="toggle-wrap">
  <div class="toggle" role="tablist" aria-label="Portfolio mode">
    <div class="thumb" aria-hidden="true"></div>
    <button type="button" role="tab" data-set-mode="ai" class="opt opt-ai">
      <Icon name="carbon:machine-learning-model" size={24} aria-hidden="true" />
      <span>AI</span>
    </button>
    <button type="button" role="tab" data-set-mode="games" class="opt opt-games">
      <Icon name="carbon:game-console" size={24} aria-hidden="true" />
      <span>GAMES</span>
    </button>
  </div>
</div>

<style>
  .toggle-wrap {
    display: flex;
    justify-content: center;
    margin: 1.75rem 0 2rem;
  }

  .toggle {
    background: var(--bg-raised);
    border: 3px solid var(--border);
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.35rem;
    position: relative;
    width: min(24rem, 100%);
  }

  /* the thumb — an accent card sitting on the active side (no slide;
     the mode-swap sweep is the transition) */
  .thumb {
    background: var(--accent);
    bottom: 0.35rem;
    left: 0.35rem;
    position: absolute;
    top: 0.35rem;
    width: calc(50% - 0.35rem);
  }
  html[data-mode="games"] .thumb {
    transform: translateX(100%);
  }
  /* bracket glyphs pinning the thumb's edges in terminal mode */
  html[data-mode="ai"] .thumb::before,
  html[data-mode="ai"] .thumb::after {
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: 1.2rem;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }
  html[data-mode="ai"] .thumb::before {
    content: "[";
    left: 0.35rem;
  }
  html[data-mode="ai"] .thumb::after {
    content: "]";
    right: 0.35rem;
  }
  .opt {
    align-items: center;
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    font-family: var(--font-display);
    font-size: calc(1.5rem * var(--display-scale, 1));
    font-weight: 600;
    gap: 0.5rem;
    justify-content: center;
    line-height: 1;
    padding: 0.65rem 0;
    position: relative;
    transition: color var(--transition-quick);
    z-index: 1;
  }
  html[data-mode="games"] .opt {
    font-size: 1.3rem;
    font-weight: 650;
  }
  .opt:hover {
    color: var(--text);
  }
  html[data-mode="ai"] .opt-ai,
  html[data-mode="games"] .opt-games {
    color: var(--accent-contrast);
  }
</style>

<script>
  const html = document.documentElement;

  // Delegated so the handler survives client-side navigations.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-set-mode]");
    if (!btn) return;
    const next = btn.dataset.setMode;
    if (!next || html.dataset.mode === next) return;
    document.dispatchEvent(new CustomEvent("libo:modeswap", { detail: { next } }));
  });

  // reflect state for a11y
  const sync = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-set-mode]").forEach((btn) => {
      btn.setAttribute("aria-selected", String(btn.dataset.setMode === html.dataset.mode));
    });
  };
  new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ["data-mode"] });
  document.addEventListener("astro:page-load", sync);
  sync();
</script>
