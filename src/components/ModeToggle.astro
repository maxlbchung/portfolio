---
import { Icon } from "astro-icon/components";
---

<!--
  The big AI ⇄ GAMES switch on the home page.
  Flipping it swaps html[data-mode], which swaps the entire theme
  (see src/styles/theme.css) plus the nav and home content.
-->
<div class="toggle-wrap">
  <div class="glow" aria-hidden="true"></div>
  <div class="toggle" role="tablist" aria-label="Portfolio mode">
    <div class="thumb" aria-hidden="true"></div>
    <button type="button" role="tab" data-set-mode="ai" class="opt opt-ai">
      <Icon name="carbon:machine-learning-model" size={26} aria-hidden="true" />
      <span>AI</span>
    </button>
    <button type="button" role="tab" data-set-mode="games" class="opt opt-games">
      <Icon name="carbon:game-console" size={26} aria-hidden="true" />
      <span>Games</span>
    </button>
  </div>
</div>

<style>
  .toggle-wrap {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0 2rem;
    position: relative;
  }

  .glow {
    background:
      radial-gradient(24rem 10rem at 35% 50%, var(--glow-a), transparent 70%),
      radial-gradient(24rem 10rem at 65% 50%, var(--glow-b), transparent 70%);
    inset: -3.5rem -6rem;
    pointer-events: none;
    position: absolute;
    z-index: -1;
  }

  .toggle {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.4rem;
    position: relative;
    width: min(24rem, 100%);
  }

  .thumb {
    background: var(--accent);
    border-radius: 999px;
    bottom: 0.4rem;
    left: 0.4rem;
    position: absolute;
    top: 0.4rem;
    transition: transform 350ms cubic-bezier(0.3, 1.3, 0.4, 1);
    width: calc(50% - 0.4rem);
  }
  html[data-mode="games"] .thumb {
    transform: translateX(100%);
  }

  .opt {
    align-items: center;
    background: none;
    border: none;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    display: flex;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    gap: 0.55rem;
    justify-content: center;
    padding: 0.65rem 0;
    position: relative;
    transition: color var(--transition-quick);
    z-index: 1;
  }

  html[data-mode="ai"] .opt-ai,
  html[data-mode="games"] .opt-games {
    color: var(--accent-contrast);
  }
</style>

<script>
  const html = document.documentElement;

  // Delegated so the handler survives client-side navigations.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-set-mode]");
    if (!btn) return;
    const next = btn.dataset.setMode as "ai" | "games";
    if (html.dataset.mode === next) return;
    html.classList.add("theme-anim");
    html.dataset.mode = next;
    try {
      localStorage.setItem("mode", next);
    } catch {}
    setTimeout(() => html.classList.remove("theme-anim"), 450);
  });

  // reflect state for a11y
  const sync = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-set-mode]").forEach((btn) => {
      btn.setAttribute("aria-selected", String(btn.dataset.setMode === html.dataset.mode));
    });
  };
  new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ["data-mode"] });
  document.addEventListener("astro:page-load", sync);
  sync();
</script>
