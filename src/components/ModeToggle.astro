---
/**
 * The big AI ⇄ GAMES switch on the home page — rendered entirely as text.
 * The track is a run of characters ([··████··]) whose thumb slides by
 * re-rendering the string, cell by cell. Flipping a side dispatches
 * `libo:modeswap` with the click point; ModeSweep.astro runs the
 * conversion wave and swaps html[data-mode] under it.
 */
---

<div class="toggle-wrap">
  <div class="toggle" role="tablist" aria-label="Portfolio mode">
    <button type="button" role="tab" data-set-mode="ai" class="opt opt-ai">AI</button>
    <pre id="mode-track" data-set-mode="" aria-hidden="true"></pre>
    <button type="button" role="tab" data-set-mode="games" class="opt opt-games">GAMES</button>
  </div>
</div>

<style>
  .toggle-wrap {
    display: flex;
    justify-content: center;
    margin: 1.75rem 0 2rem;
  }

  .toggle {
    align-items: center;
    display: flex;
    gap: 0.6rem;
  }

  .opt {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: calc(1.6rem * var(--display-scale, 1));
    line-height: 1;
    padding: 0.2rem 0.35rem;
    transition: background-color var(--transition-quick), color var(--transition-quick);
  }
  .opt:hover {
    color: var(--text);
  }
  /* active side: inverse video — emphasis without leaving text-land */
  html[data-mode="ai"] .opt-ai,
  html[data-mode="games"] .opt-games {
    background: var(--text);
    color: var(--bg);
  }
  html[data-mode="games"] .opt-games {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  #mode-track {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    line-height: 1;
    margin: 0;
    user-select: none;
  }
  html[data-mode="games"] #mode-track {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    #mode-track {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const html = document.documentElement;
  const CELLS = 22;
  const THUMB = 8;

  // p ∈ [0,1]: 0 = thumb left (AI), 1 = thumb right (GAMES)
  const trackString = (p: number) => {
    const pos = Math.round(p * (CELLS - THUMB));
    return `[${"·".repeat(pos)}${"█".repeat(THUMB)}${"·".repeat(CELLS - THUMB - pos)}]`;
  };

  let current = html.dataset.mode === "games" ? 1 : 0;
  let timer: ReturnType<typeof setInterval> | undefined;

  const render = () => {
    const track = document.getElementById("mode-track");
    if (track) track.textContent = trackString(current);
  };

  // Slide the thumb by re-rendering the string one step at a time.
  const animateTo = (target: number) => {
    clearInterval(timer);
    timer = setInterval(() => {
      const step = 1 / (CELLS - THUMB);
      if (Math.abs(target - current) <= step) {
        current = target;
        clearInterval(timer);
      } else {
        current += Math.sign(target - current) * step;
      }
      render();
    }, 28);
  };

  const sync = () => {
    animateTo(html.dataset.mode === "games" ? 1 : 0);
    document.querySelectorAll<HTMLButtonElement>(".opt[data-set-mode]").forEach((btn) => {
      btn.setAttribute("aria-selected", String(btn.dataset.setMode === html.dataset.mode));
    });
  };

  // Delegated so handlers survive client-side navigations. The empty
  // data-set-mode on the track means "the other mode".
  document.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-set-mode]");
    if (!el) return;
    const next = el.dataset.setMode || (html.dataset.mode === "ai" ? "games" : "ai");
    if (html.dataset.mode === next) return;
    // keyboard activation has no coordinates — use the control's center
    let { clientX: x, clientY: y } = e;
    if (!x && !y) {
      const r = el.getBoundingClientRect();
      x = r.left + r.width / 2;
      y = r.top + r.height / 2;
    }
    document.dispatchEvent(new CustomEvent("libo:modeswap", { detail: { next, x, y } }));
  });

  new MutationObserver(sync).observe(html, { attributes: true, attributeFilter: ["data-mode"] });
  document.addEventListener("astro:page-load", () => {
    current = html.dataset.mode === "games" ? 1 : 0;
    render();
    sync();
  });
  render();
  sync();
</script>
