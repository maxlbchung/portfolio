---
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";

const links = [
  { href: site.socials.github, icon: "simple-icons:github", label: "github" },
  { href: site.socials.linkedin, icon: "simple-icons:linkedin", label: "linkedin" },
  { href: site.socials.itch, icon: "simple-icons:itchdotio", label: "itch.io" },
  { href: site.socials.youtube, icon: "simple-icons:youtube", label: "youtube" },
  { href: `mailto:${site.email}`, icon: "carbon:email", label: "email" },
];
---

<footer>
  <div class="inner">
    <p class="muted">© {new Date().getFullYear()} {site.name}</p>
    <div class="socials">
      {
        links.map(({ href, icon, label }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" class="icon-link">
            <Icon name={icon} size={14} aria-hidden="true" />
            <span>{label}</span>
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: auto;
  }
  .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 1.25rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
  }
</style>
