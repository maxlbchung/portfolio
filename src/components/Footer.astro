---
import { site } from "@/data/site";

const links = [
  { href: site.socials.github, label: "github" },
  { href: site.socials.linkedin, label: "linkedin" },
  { href: site.socials.itch, label: "itch.io" },
  { href: site.socials.youtube, label: "youtube" },
  { href: `mailto:${site.email}`, label: "email" },
];
---

<footer>
  <div class="rule" aria-hidden="true">{"─".repeat(400)}</div>
  <div class="inner">
    <p class="muted">© {new Date().getFullYear()} {site.name}</p>
    <div class="socials">
      {
        links.map(({ href, label }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" class="icon-link">
            {label}
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: auto;
    overflow: hidden;
  }
  .rule {
    color: var(--border);
    font-family: var(--font-mono);
    line-height: 1;
    overflow: hidden;
    white-space: nowrap;
  }
  .inner {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--content-width);
    padding: 1.25rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
  }
</style>
