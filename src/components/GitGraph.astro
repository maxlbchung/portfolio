---
/**
 * GitHub contribution graph, fetched client-side from the public
 * github-contributions-api.jogruber.de mirror.
 *
 * AI mode renders it as pure text — one █ per day, dimmed by contribution
 * level. Using a single glyph for every cell keeps the columns aligned
 * even when the block character is substituted from a fallback font with
 * a different advance width. Games mode renders sharp SVG pixels colored
 * from theme tokens.
 */
interface Props {
  username: string;
}
const { username } = Astro.props;
---

<div class="gitgraph" data-user={username}>
  <div class="scroll">
    <pre id="gh-ascii" class="only-ai" role="img" aria-label="GitHub contribution graph"></pre>
    <div id="gh-svg" class="only-games"></div>
  </div>
  <p id="gh-graph-label" class="muted"></p>
</div>

<style is:global>
  .gitgraph .scroll {
    direction: rtl; /* keep the most recent weeks in view on overflow */
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .gitgraph #gh-ascii {
    direction: ltr;
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.16em;
    line-height: 1.35;
    margin: 0;
  }
  .gitgraph #gh-ascii .pad {
    visibility: hidden;
  }
  .gitgraph #gh-ascii .l0 {
    opacity: 0.14;
  }
  .gitgraph #gh-ascii .l1 {
    opacity: 0.35;
  }
  .gitgraph #gh-ascii .l2 {
    opacity: 0.55;
  }
  .gitgraph #gh-ascii .l3 {
    opacity: 0.78;
  }
  .gitgraph #gh-ascii .l4 {
    opacity: 1;
  }
  .gitgraph #gh-svg {
    direction: ltr;
  }
  .gitgraph #gh-svg svg {
    display: block;
    min-width: 640px;
    width: 100%;
  }
  .gitgraph #gh-svg rect {
    fill: var(--accent);
  }
  .gitgraph #gh-svg rect.l0 {
    fill: var(--surface);
  }
  .gitgraph #gh-svg rect.l1 {
    opacity: 0.35;
  }
  .gitgraph #gh-svg rect.l2 {
    opacity: 0.6;
  }
  .gitgraph #gh-svg rect.l3 {
    opacity: 0.8;
  }
  .gitgraph #gh-svg rect.l4 {
    opacity: 1;
  }
  .gitgraph #gh-graph-label {
    font-size: 0.85rem;
    margin-top: 0.35rem;
  }
</style>

<script>
  interface Contribution {
    date: string;
    count: number;
    level: number;
  }

  const CELL = 10;
  const GAP = 3;
  const STEP = CELL + GAP;

  // One █ per day — a single glyph everywhere means every column has the
  // exact same advance width, so the grid can't drift out of alignment.
  const toAscii = (weeks: number[][]) => {
    let out = "";
    for (let d = 0; d < 7; d++) {
      for (const week of weeks) {
        const level = week[d];
        const cls = level === undefined || level < 0 ? "pad" : `l${level}`;
        out += `<span class="${cls}">█</span>`;
      }
      out += "\n";
    }
    return out;
  };

  const toSvg = (weeks: number[][]) => {
    const width = weeks.length * STEP - GAP;
    const height = 7 * STEP - GAP;
    let cells = "";
    weeks.forEach((week, w) => {
      week.forEach((level, d) => {
        if (level < 0) return; // padding day outside the data range
        cells += `<rect class="l${level}" x="${w * STEP}" y="${d * STEP}" width="${CELL}" height="${CELL}"/>`;
      });
    });
    return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" role="img" aria-label="GitHub contribution graph">${cells}</svg>`;
  };

  const emptyWeeks = () => Array.from({ length: 53 }, () => Array(7).fill(0));

  // group daily contributions into Sunday-first weeks
  const toWeeks = (days: Contribution[]) => {
    const weeks: number[][] = [];
    let week: number[] = [];
    for (const day of days) {
      const dow = new Date(`${day.date}T00:00:00Z`).getUTCDay();
      if (dow === 0 && week.length > 0) {
        weeks.push(week);
        week = [];
      }
      if (week.length === 0 && dow > 0 && weeks.length === 0) week = Array(dow).fill(-1);
      week.push(day.level);
    }
    if (week.length > 0) weeks.push(week);
    return weeks;
  };

  let cache: { weeks: number[][]; total: number } | null = null;

  const paint = (weeks: number[][]) => {
    const ascii = document.getElementById("gh-ascii");
    const svg = document.getElementById("gh-svg");
    if (ascii) ascii.innerHTML = toAscii(weeks);
    if (svg) svg.innerHTML = toSvg(weeks);
  };

  const render = async () => {
    const box = document.querySelector<HTMLElement>(".gitgraph");
    if (!box) return;
    const label = document.getElementById("gh-graph-label");
    paint(emptyWeeks());
    try {
      if (!cache) {
        const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${box.dataset.user}?y=last`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: { total: Record<string, number>; contributions: Contribution[] } = await res.json();
        cache = { weeks: toWeeks(data.contributions), total: data.total.lastYear ?? 0 };
      }
      // the container may have been swapped out while fetching
      if (!document.querySelector(".gitgraph")) return;
      paint(cache.weeks);
      const liveLabel = document.getElementById("gh-graph-label");
      if (liveLabel) liveLabel.textContent = `${cache.total} contributions in the last year`;
    } catch {
      if (label) label.textContent = "";
      // leave the placeholder grid if the API is unreachable
    }
  };

  render();
  document.addEventListener("astro:page-load", render);
</script>
