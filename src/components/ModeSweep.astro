---
/**
 * The AI ⇄ games flip animation. Listens for `libo:modeswap` events
 * (dispatched by ModeToggle / Navbar) and runs a conversion wave over a
 * full-screen canvas grid.
 *
 * The wave is made only of the DESTINATION mode's matter — flickering
 * ASCII characters when switching to AI, dark cold pixel-art pixels when
 * switching to games. It sweeps horizontally toward the side that was
 * toggled (rightward into GAMES, leftward into AI):
 *
 *   1. cover  — a ragged vertical front crosses the screen, each cell
 *               filling with new-mode matter and hiding the page beneath.
 *   2. flip   — once the screen is fully covered, html[data-mode] swaps.
 *   3. reveal — following the same front, cells pop away to uncover the
 *               newly-themed page.
 *
 * Every cell's timing carries random jitter, so some cells convert early
 * and some lag behind. Falls back to a plain cross-fade for reduced motion.
 */
---

<script>
  import { navigate } from "astro:transitions/client";
  import {
    SWEEP_GLYPHS,
    SWEEP_GLYPHS_PURPLE,
    SWEEP_GLYPHS_PURPLE_POP,
    SWEEP_PIXELS_COLD,
    SWEEP_PIXELS_COLD_POP,
    drawAsciiCell,
    drawPixelCell,
    makeOverlayCanvas,
  } from "@/scripts/fx";

  const html = document.documentElement;
  let running = false;

  const persist = (m: string) => {
    try {
      localStorage.setItem("mode", m);
    } catch {}
  };

  const instantFlip = (next: string) => {
    html.classList.add("theme-anim");
    html.dataset.mode = next;
    setTimeout(() => html.classList.remove("theme-anim"), 450);
  };

  const randGlyph = () => SWEEP_GLYPHS[Math.floor(Math.random() * SWEEP_GLYPHS.length)] ?? "@";
  const randGlyphColor = () => {
    if (Math.random() < 0.12)
      return SWEEP_GLYPHS_PURPLE_POP[Math.floor(Math.random() * SWEEP_GLYPHS_PURPLE_POP.length)] ?? "#c084fc";
    return SWEEP_GLYPHS_PURPLE[Math.floor(Math.random() * SWEEP_GLYPHS_PURPLE.length)] ?? "#8250cf";
  };
  const randPixel = () => {
    if (Math.random() < 0.12)
      return SWEEP_PIXELS_COLD_POP[Math.floor(Math.random() * SWEEP_PIXELS_COLD_POP.length)] ?? "#1d2b53";
    return SWEEP_PIXELS_COLD[Math.floor(Math.random() * SWEEP_PIXELS_COLD.length)] ?? "#1d2b53";
  };

  const sweep = (next: string, href?: string) => {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const [canvas, ctx] = makeOverlayCanvas();
    // mount on <html>, not <body> — a client-side navigation under the
    // sweep replaces the body, which would tear the canvas down mid-wave
    html.appendChild(canvas);

    const CELL = 18;
    const cols = Math.ceil(w / CELL);
    const rows = Math.ceil(h / CELL);

    // wave timing (ms). Invariant: HOLD > COVER + JITTER, so the earliest
    // cell only clears after the whole screen is covered and the DOM has
    // flipped underneath.
    const COVER = 340; // front travel time across the screen
    const JITTER = 120; // per-cell raggedness
    const HOLD = 480; // how long a cell stays covered
    const flipAt = COVER + JITTER + 5; // screen guaranteed covered here

    // horizontal front, moving toward the side that was toggled:
    // → rightward into GAMES, ← leftward into AI
    const dir = next === "games" ? 1 : -1;

    const coverAt = new Float32Array(cols * rows);
    const clearAt = new Float32Array(cols * rows);
    const state = new Int32Array(cols * rows); // last drawn frame key, 0 = untouched
    for (let y = 0; y < rows; y++) {
      for (let x = 0; x < cols; x++) {
        const i = y * cols + x;
        const cx = (x * CELL + CELL / 2) / w;
        const frac = dir > 0 ? cx : 1 - cx;
        coverAt[i] = frac * COVER + Math.random() * JITTER;
        clearAt[i] = (coverAt[i] ?? 0) + HOLD + Math.random() * 70;
      }
    }

    let flipped = false;
    const start = performance.now();

    const tick = (now: number) => {
      const t = now - start;

      if (!flipped && t >= flipAt) {
        // hidden under full cover: flip the theme, and when the swap was
        // triggered off the home page, run the navigation home too
        html.dataset.mode = next;
        if (href) navigate(href);
        flipped = true;
      }

      let alive = false;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = y * cols + x;
          const cov = coverAt[i] ?? 0;
          const clr = clearAt[i] ?? 0;
          if (t < cov) {
            alive = true;
            continue; // front hasn't reached this cell yet
          }
          if (t >= clr) {
            if (state[i] !== -1) {
              ctx.clearRect(x * CELL - 0.5, y * CELL - 0.5, CELL + 1, CELL + 1);
              state[i] = -1;
            }
            continue;
          }
          alive = true;
          const frame = Math.floor((t - cov) / 80); // flicker cadence
          if (state[i] === frame + 1) continue;
          state[i] = frame + 1;
          if (next === "ai") drawAsciiCell(ctx, x * CELL, y * CELL, CELL, randGlyph(), randGlyphColor());
          else drawPixelCell(ctx, x * CELL, y * CELL, CELL, randPixel());
        }
      }

      if (alive) requestAnimationFrame(tick);
      else {
        canvas.remove();
        running = false;
      }
    };
    requestAnimationFrame(tick);
  };

  document.addEventListener("libo:modeswap", (e) => {
    const { next, href } = (e as CustomEvent<{ next: string; href?: string }>).detail;
    if (running || (next !== "ai" && next !== "games") || html.dataset.mode === next) return;
    persist(next);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (href) return void navigate(href); // mode resolves after the swap
      return instantFlip(next);
    }
    running = true;
    sweep(next, href);
  });
</script>
