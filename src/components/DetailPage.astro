---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { imagePath, withBase } from "@/lib/url";

interface Link { label: string; url: string; icon?: string; }
interface Props {
  title: string;
  mode: "ai" | "games";
  description?: string;
  backPath: string;
  backLabel: string;
  meta?: string;
  image?: string;
  skills?: string[];
  links?: Link[];
}

const { title, mode, description, backPath, backLabel, meta, image, skills = [], links = [] } = Astro.props;
---

<Layout title={title} mode={mode} description={description}>
  <a class="text-link back" href={withBase(backPath)} data-return-link><Icon name="carbon:arrow-left" size={14} aria-hidden="true" /><span>{backLabel}</span></a>
  <h1>{title}</h1>
  {meta && <p class="muted meta">{meta}</p>}
  <slot name="metadata" />
  {skills.length > 0 && <div class="chips">{skills.map((skill) => <span class="chip">{skill}</span>)}</div>}
  {image && <div class:list={["hero-frame", mode === "ai" ? "ascii-frame" : "pixel-frame"]}><img src={imagePath(image)} alt="" /></div>}
  <article class="prose"><slot /></article>
  {links.length > 0 && <div class="links">{links.map((link) => <a class="icon-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.icon && <Icon name={link.icon} size={15} aria-hidden="true" />}{link.label}</a>)}</div>}
</Layout>

<style>
  .back { align-items: center; display: inline-flex; gap: .35rem; margin-bottom: 1.5rem; }
  h1 { font-size: calc(2.2rem * var(--display-scale, 1)); }
  .meta { margin-top: .5rem; }
  .chips, .links { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.25rem; }
  .prose { margin-top: 1.5rem; }
  .prose :global(p) { margin-bottom: .9rem; }
  .prose :global(h2) { margin: 1.75rem 0 .5rem; }
  .prose :global(h2) { font-size: calc(1.4rem * var(--display-scale, 1)); }
  .prose :global(h3) { font-size: calc(1.15rem * var(--display-scale, 1)); margin: 1.5rem 0 .4rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 .9rem; padding-left: 1.3rem; }
  .prose :global(li) { margin-bottom: .3rem; }
  .prose :global(a) { border-bottom: 1px solid transparent; color: var(--link); transition: border-color var(--transition-quick); }
  .prose :global(a:hover) { border-bottom-color: var(--link); }
  .prose :global(code) { background: var(--surface); font-size: .9em; padding: .1em .35em; }
  .prose :global(pre) { background: var(--bg-raised); border: 1px solid var(--border); overflow-x: auto; padding: 1rem; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(blockquote) { border-left: 3px solid var(--accent); color: var(--muted); margin: 0 0 .9rem; padding-left: 1rem; }
  .prose :global(img) { border: 2px solid var(--border); }
  :global(.award) { align-items: center; color: var(--accent); display: flex; gap: .4rem; margin-top: .8rem; }
  .hero-frame { border: 1px solid var(--border); line-height: 0; margin: 1.5rem auto 0; max-width: 100%; position: relative; width: fit-content; }
  .hero-frame img { display: block; height: auto; max-height: 360px; max-width: 100%; object-fit: contain; width: auto; }
  .ascii-frame::before, .ascii-frame::after { background: var(--bg); color: var(--text); font-family: var(--font-mono); line-height: 1; position: absolute; }
  .ascii-frame::before { content: "+"; left: -.32em; top: -.55em; }
  .ascii-frame::after { bottom: -.55em; content: "+"; right: -.32em; }
  .pixel-frame { border-width: 3px; box-shadow: var(--shadow-card); }
  :global(.detail-subheading) { font-size: calc(1.35rem * var(--display-scale, 1)); margin-top: 1.25rem; }
  :global(.theme) { align-items: center; color: var(--accent-2); display: flex; gap: .4rem; margin-top: .75rem; }
</style>
