---
import { Icon } from "astro-icon/components";
import { nav } from "@/data/site";
import { withBase } from "@/lib/url";

const { pathname } = Astro.url;
const current = (path: string) =>
  pathname.replace(/\/$/, "") === withBase(path).replace(/\/$/, "");
---

<header>
  <!-- Two nav sets; CSS shows the one matching html[data-mode] -->
  {
    (["ai", "games"] as const).map((m) => (
      <nav class={m === "ai" ? "only-ai" : "only-games"} aria-label={`${m} navigation`}>
        {nav[m].map(({ path, label }) =>
          current(path) ? (
            <span class="active" aria-current="page">
              {label}
            </span>
          ) : (
            <a href={withBase(path)}>{label}</a>
          ),
        )}
      </nav>
    ))
  }

  <button
    id="mode-swap"
    type="button"
    title="Switch between AI and games"
    aria-label="Switch between AI and games"
    data-home={withBase("/")}
  >
    <Icon name="carbon:arrows-horizontal" size={16} aria-hidden="true" />
    <span class="only-ai">games?</span>
    <span class="only-games">ai?</span>
  </button>
</header>

<style>
  header {
    align-items: center;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    background: color-mix(in oklch, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
    display: flex;
    height: var(--nav-height);
    justify-content: center;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 50;
  }

  nav {
    align-items: center;
    display: flex;
    font-size: 0.95rem;
    font-weight: 500;
    gap: 0.35rem;
  }

  nav a,
  nav .active {
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

  nav a {
    color: var(--muted);
    transition: color var(--transition-quick), background-color var(--transition-quick);
  }
  nav a:hover {
    background: var(--surface);
    color: var(--text);
  }

  nav .active {
    background: var(--text);
    color: var(--bg);
  }

  #mode-swap {
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.78rem;
    gap: 0.3rem;
    margin-left: 0.5rem;
    padding: 0.25rem 0.7rem;
    position: absolute;
    right: 1rem;
    transition: color var(--transition-quick), border-color var(--transition-quick);
  }
  #mode-swap:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 480px) {
    #mode-swap span {
      display: none;
    }
    nav {
      font-size: 0.88rem;
    }
    nav a,
    nav .active {
      padding: 0.3rem 0.55rem;
    }
  }
</style>

<script>
  // Small nav shortcut: flip mode and land on the (dual-mode) home page.
  const swap = document.getElementById("mode-swap");
  swap?.addEventListener("click", () => {
    const html = document.documentElement;
    const next = html.dataset.mode === "ai" ? "games" : "ai";
    try {
      localStorage.setItem("mode", next);
    } catch {}
    const home = (swap as HTMLElement).dataset.home ?? "/";
    // On the home page flip in place (the big toggle animates); elsewhere, go home.
    if (window.location.pathname.replace(/\/$/, "") === home.replace(/\/$/, "")) {
      html.classList.add("theme-anim");
      html.dataset.mode = next;
      setTimeout(() => html.classList.remove("theme-anim"), 450);
    } else {
      window.location.href = home;
    }
  });
</script>
