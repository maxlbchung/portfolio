---
import { Icon } from "astro-icon/components";
import { nav } from "@/data/site";
import { withBase } from "@/lib/url";

const { pathname } = Astro.url;
const current = (path: string) =>
  pathname.replace(/\/$/, "") === withBase(path).replace(/\/$/, "");
const modes = ["ai", "games"] as const;
---

<!-- transition:persist keeps the navbar alive across client-side
     navigations; a small script re-marks the active link. -->
<header transition:persist="site-nav">
  <div class="nav-box">
    <!-- Two nav sets; CSS shows the one matching html[data-mode] -->
    {
      modes.map((m) => (
        <nav class={m === "ai" ? "only-ai" : "only-games"} data-nav={m} aria-label={`${m} navigation`}>
          {nav[m].map(({ path, label }) => (
            <a
              href={withBase(path)}
              data-path={withBase(path).replace(/\/$/, "") || "/"}
              data-exact={path === "/" ? "true" : undefined}
              class={current(path) ? "active" : ""}
              aria-current={current(path) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>

  <button
    id="mode-swap"
    type="button"
    title="Switch between AI and games"
    aria-label="Switch between AI and games"
    data-home={withBase("/")}
  >
    <Icon name="carbon:arrows-horizontal" size={14} aria-hidden="true" />
    <span class="only-ai">games?</span>
    <span class="only-games">ai?</span>
  </button>

  <!-- the header's bottom edge, drawn in characters -->
  <div class="nav-rule" aria-hidden="true">
    {"─".repeat(400)}
  </div>
</header>

<style>
  header {
    align-items: center;
    background: var(--bg);
    display: flex;
    height: var(--nav-height);
    justify-content: center;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 50;
  }

  .nav-rule {
    bottom: -0.35em;
    color: var(--border);
    font-family: var(--font-mono);
    left: 0;
    line-height: 1;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    right: 0;
    white-space: nowrap;
  }

  nav {
    align-items: center;
    display: flex;
    font-size: 0.9rem;
    gap: 0.4rem;
  }

  /* every nav item sits in its own small card, like the chips below */
  nav a {
    border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    color: var(--muted);
    padding: 0.18rem 0.65rem;
    transition:
      background-color var(--transition-quick),
      border-color var(--transition-quick),
      color var(--transition-quick);
    white-space: nowrap;
  }
  html[data-mode="games"] nav a {
    border-width: 2px;
  }
  nav a:hover {
    border-color: var(--text);
    color: var(--text);
  }
  html[data-mode="games"] nav a:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }
  /* active page: filled card — inverse video / accent slab */
  nav a.active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  html[data-mode="games"] nav a.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  #mode-swap {
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.82rem;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    position: absolute;
    right: 1rem;
    transition:
      background-color var(--transition-quick),
      border-color var(--transition-quick),
      color var(--transition-quick);
  }
  #mode-swap:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }
  html[data-mode="games"] #mode-swap {
    border-width: 2px;
  }
  html[data-mode="games"] #mode-swap:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  /* Small screens: the swap button joins the flex row, drops its label
     (icon only), and everything tightens so all items + button fit. */
  @media (max-width: 560px) {
    header {
      gap: 0.3rem;
      padding: 0 0.4rem;
    }
    #mode-swap {
      padding: 0.22rem 0.3rem;
      position: static;
    }
    #mode-swap span {
      display: none;
    }
    nav {
      font-size: 0.78rem;
      gap: 0.25rem;
    }
    nav a {
      padding: 0.15rem 0.35rem;
    }
  }
  @media (max-width: 360px) {
    nav {
      font-size: 0.72rem;
      gap: 0.2rem;
    }
    nav a {
      padding: 0.12rem 0.25rem;
    }
  }
</style>

<script>
  // ── Active link marking ───────────────────────────────────────────────
  const currentPath = () => {
    const p = window.location.pathname.replace(/\/$/, "");
    return p === "" ? "/" : p;
  };

  const markActive = () => {
    const path = currentPath();
    document.querySelectorAll<HTMLElement>("header nav[data-nav]").forEach((nav) => {
      let match: HTMLAnchorElement | null = null;
      let prefix: HTMLAnchorElement | null = null;
      nav.querySelectorAll<HTMLAnchorElement>("a[data-path]").forEach((a) => {
        const p = a.dataset.path!;
        if (path === p) match = a;
        // longest-prefix match keeps e.g. /dev-diary/<post> on "Dev Diary";
        // the home link only matches exactly (every page shares its prefix)
        else if (!a.dataset.exact && path.startsWith(`${p}/`) && p.length > (prefix?.dataset.path?.length ?? 0))
          prefix = a;
      });
      const active = match ?? prefix;
      nav.querySelectorAll("a").forEach((a) => {
        a.classList.toggle("active", a === active);
        if (a === active) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
    });
  };

  markActive();
  document.addEventListener("astro:page-load", markActive);

  // ── Mode swap shortcut ────────────────────────────────────────────────
  // Delegated so it survives client-side navigations.
  document.addEventListener("click", (e) => {
    const swap = (e.target as HTMLElement).closest<HTMLElement>("#mode-swap");
    if (!swap) return;
    const html = document.documentElement;
    const next = html.dataset.mode === "ai" ? "games" : "ai";
    try {
      localStorage.setItem("mode", next);
    } catch {}
    const home = swap.dataset.home ?? "/";
    // On the home page run the conversion sweep in place; elsewhere, go home.
    if (currentPath() === (home.replace(/\/$/, "") || "/")) {
      const r = swap.getBoundingClientRect();
      document.dispatchEvent(
        new CustomEvent("libo:modeswap", {
          detail: { next, x: r.left + r.width / 2, y: r.top + r.height / 2 },
        }),
      );
    } else {
      window.location.href = home;
    }
  });
</script>
