---
import { Icon } from "astro-icon/components";
import { nav } from "@/data/site";
import { withBase } from "@/lib/url";

const { pathname } = Astro.url;
const current = (path: string) =>
  pathname.replace(/\/$/, "") === withBase(path).replace(/\/$/, "");
const modes = ["ai", "games"] as const;
---

<!-- transition:persist keeps the navbar (and its sliding highlight) alive
     across client-side navigations so it can glide to the new active item. -->
<header transition:persist="site-nav">
  <div class="nav-box" id="nav-box">
    <!-- Two nav sets; CSS shows the one matching html[data-mode] -->
    {
      modes.map((m) => (
        <nav class={m === "ai" ? "only-ai" : "only-games"} data-nav={m} aria-label={`${m} navigation`}>
          {nav[m].map(({ path, label }) => (
            <a
              href={withBase(path)}
              data-path={withBase(path).replace(/\/$/, "") || "/"}
              data-exact={path === "/" ? "true" : undefined}
              class={current(path) ? "active" : ""}
              aria-current={current(path) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      ))
    }

    <!-- Sliding highlight card + an inverted-color copy of the labels,
         clipped to the highlight's rect so text inverts as it passes. -->
    <div id="nav-pill" aria-hidden="true"></div>
    {
      modes.map((m) => (
        <div class:list={["nav-overlay", m === "ai" ? "only-ai" : "only-games"]} data-overlay={m} aria-hidden="true">
          {nav[m].map(({ path, label }) => (
            <span data-path={withBase(path).replace(/\/$/, "") || "/"}>{label}</span>
          ))}
        </div>
      ))
    }
  </div>

  <button
    id="mode-swap"
    type="button"
    title="Switch between AI and games"
    aria-label="Switch between AI and games"
    data-home={withBase("/")}
  >
    <Icon name="carbon:arrows-horizontal" size={14} aria-hidden="true" />
    <span class="only-ai">games?</span>
    <span class="only-games">ai?</span>
  </button>

  <!-- the header's bottom edge, drawn in characters -->
  <div class="nav-rule" aria-hidden="true">
    {"─".repeat(400)}
  </div>
</header>

<style>
  header {
    align-items: center;
    background: var(--bg);
    display: flex;
    height: var(--nav-height);
    justify-content: center;
    left: 0;
    position: fixed;
    right: 0;
    top: 0;
    z-index: 50;
  }

  .nav-box {
    position: relative;
  }

  .nav-rule {
    bottom: -0.35em;
    color: var(--border);
    font-family: var(--font-mono);
    left: 0;
    line-height: 1;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    right: 0;
    white-space: nowrap;
  }

  nav,
  .nav-overlay {
    align-items: center;
    display: flex;
    font-size: 0.9rem;
    gap: 0.4rem;
  }

  /* every nav item sits in its own small card, like the chips below;
     overlay spans share the exact metrics so labels line up */
  nav a,
  .nav-overlay span {
    border: 1px solid transparent;
    padding: 0.18rem 0.65rem;
    white-space: nowrap;
  }
  html[data-mode="games"] nav a,
  html[data-mode="games"] .nav-overlay span {
    border-width: 2px;
  }

  nav a {
    border-color: color-mix(in srgb, var(--border) 60%, transparent);
    color: var(--muted);
    transition:
      border-color var(--transition-quick),
      color var(--transition-quick);
  }
  nav a:hover {
    border-color: var(--link);
    color: var(--link);
  }
  nav a.active {
    color: var(--text);
  }
  /* No-JS fallback: show the active card filled statically */
  html:not(.js) nav a.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  /* the gliding highlight: a filled accent card that slides to the
     active item — same accent pattern in both modes */
  #nav-pill {
    background: var(--accent);
    bottom: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 0;
  }

  .nav-overlay {
    color: var(--accent-contrast);
    inset: 0;
    pointer-events: none;
    position: absolute;
    /* fully collapsed clip until the script measures the highlight */
    clip-path: inset(0 100% 0 0);
  }

  /* The glide — highlight and clipped overlay move in lockstep */
  html.js #nav-pill,
  html.js .nav-overlay {
    transition:
      left 250ms cubic-bezier(0.3, 1, 0.4, 1),
      width 250ms cubic-bezier(0.3, 1, 0.4, 1),
      clip-path 250ms cubic-bezier(0.3, 1, 0.4, 1),
      opacity 150ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    html.js #nav-pill,
    html.js .nav-overlay {
      transition: none;
    }
  }

  #mode-swap {
    align-items: center;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-body);
    font-size: 0.82rem;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    position: absolute;
    right: 1rem;
    transition:
      background-color var(--transition-quick),
      border-color var(--transition-quick),
      color var(--transition-quick);
  }
  #mode-swap:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }
  html[data-mode="games"] #mode-swap {
    border-width: 2px;
  }

  /* Small screens: the swap button joins the flex row, drops its label
     (icon only), and everything tightens so all items + button fit. */
  @media (max-width: 560px) {
    header {
      gap: 0.3rem;
      padding: 0 0.4rem;
    }
    #mode-swap {
      padding: 0.22rem 0.3rem;
      position: static;
    }
    #mode-swap span {
      display: none;
    }
    nav,
    .nav-overlay {
      font-size: 0.78rem;
      gap: 0.25rem;
    }
    nav a,
    .nav-overlay span {
      padding: 0.15rem 0.35rem;
    }
  }
  @media (max-width: 360px) {
    nav,
    .nav-overlay {
      font-size: 0.72rem;
      gap: 0.2rem;
    }
    nav a,
    .nav-overlay span {
      padding: 0.12rem 0.25rem;
    }
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  // ── Sliding nav highlight ─────────────────────────────────────────────
  // Finds the active link in the visible nav set, glides the filled card
  // under it, and clips the inverted overlay to it so the label inverts.
  const currentPath = () => {
    const p = window.location.pathname.replace(/\/$/, "");
    return p === "" ? "/" : p;
  };

  const findActive = (nav: Element) => {
    const path = currentPath();
    let match: HTMLAnchorElement | null = null;
    let prefix: HTMLAnchorElement | null = null;
    nav.querySelectorAll<HTMLAnchorElement>("a[data-path]").forEach((a) => {
      const p = a.dataset.path!;
      if (path === p) match = a;
      // longest-prefix match keeps e.g. /dev-diary/<post> on "Dev Diary";
      // the home link only matches exactly (every page shares its prefix)
      else if (!a.dataset.exact && path.startsWith(`${p}/`) && p.length > (prefix?.dataset.path?.length ?? 0))
        prefix = a;
    });
    return match ?? prefix;
  };

  let firstPlace = true;
  const place = () => {
    const box = document.getElementById("nav-box");
    const pill = document.getElementById("nav-pill");
    if (!box || !pill) return;

    const navEl = [...box.querySelectorAll<HTMLElement>("nav[data-nav]")].find((n) => n.offsetParent !== null);
    if (!navEl) return;
    const overlay = box.querySelector<HTMLElement>(`.nav-overlay[data-overlay="${navEl.dataset.nav}"]`);
    if (!overlay) return;

    const skipAnim = firstPlace;
    firstPlace = false;
    const setNow = (el: HTMLElement, fn: () => void) => {
      if (!skipAnim) return fn();
      el.style.transition = "none";
      fn();
      requestAnimationFrame(() => (el.style.transition = ""));
    };

    // refresh active link styling (both nav sets stay in sync)
    box.querySelectorAll<HTMLElement>("nav[data-nav]").forEach((n) => {
      const active = findActive(n);
      n.querySelectorAll("a").forEach((a) => {
        a.classList.toggle("active", a === active);
        if (a === active) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
    });

    const active = findActive(navEl);
    if (!active) {
      pill.style.opacity = "0";
      setNow(overlay, () => (overlay.style.clipPath = "inset(0 100% 0 0)"));
      return;
    }

    const boxRect = box.getBoundingClientRect();
    const rect = active.getBoundingClientRect();
    const left = rect.left - boxRect.left;
    const right = boxRect.right - rect.right;

    setNow(pill, () => {
      pill.style.left = `${left}px`;
      pill.style.width = `${rect.width}px`;
      pill.style.opacity = "1";
    });
    setNow(overlay, () => {
      overlay.style.clipPath = `inset(0 ${right}px 0 ${left}px)`;
    });
  };

  place();
  document.addEventListener("astro:page-load", () => place());
  window.addEventListener("resize", () => place());
  document.fonts?.addEventListener("loadingdone", () => place());
  // re-measure when the AI/games mode flips (the visible nav set changes)
  new MutationObserver(() => place()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-mode"],
  });

  // ── Mode swap shortcut ────────────────────────────────────────────────
  // Delegated so it survives client-side navigations.
  document.addEventListener("click", (e) => {
    const swap = (e.target as HTMLElement).closest<HTMLElement>("#mode-swap");
    if (!swap) return;
    const html = document.documentElement;
    const next = html.dataset.mode === "ai" ? "games" : "ai";
    try {
      localStorage.setItem("mode", next);
    } catch {}
    const home = swap.dataset.home ?? "/";
    // On the home page run the conversion sweep in place; elsewhere,
    // navigate home client-side (instant via prefetch, and no intro replay).
    if (currentPath() === (home.replace(/\/$/, "") || "/")) {
      document.dispatchEvent(new CustomEvent("libo:modeswap", { detail: { next } }));
    } else {
      navigate(home);
    }
  });
</script>
