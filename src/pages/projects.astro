---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";
import { projects } from "@/data/projects";
---

<Layout title="Projects" mode="ai" description="AI and software projects by Max Li-Bo Chung.">
  <h1>Projects</h1>
  <p class="muted intro">
    Agent workflows, LLM tooling, and student software. Everything public lives on <a class="text-link" href={site.socials.github} target="_blank" rel="noopener noreferrer">my GitHub</a> and the <a class="text-link" href={site.socials.githubOrg} target="_blank" rel="noopener noreferrer">Reodite org</a>.
  </p>

  <div class="cards">
    {projects.map((p) => <EntryCard {...p} />)}
  </div>

  <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost more">
    <Icon name="simple-icons:github" size={16} aria-hidden="true" />
    <span>More on GitHub</span>
  </a>
</Layout>

<style>
  h1 {
    font-size: 2.4rem;
  }
  .intro {
    margin-top: 0.6rem;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
