---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { getCollection } from "astro:content";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";

const projects = (await getCollection("projects")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Projects" mode="ai" description="AI and software projects by Max Li-Bo Chung.">
  <h1>Projects</h1>
  <p class="muted intro">
    Agent workflows, LLM tooling, and student software. Everything public lives on <a class="text-link" href={site.socials.github} target="_blank" rel="noopener noreferrer">my GitHub</a> and the <a class="text-link" href={site.socials.githubOrg} target="_blank" rel="noopener noreferrer">Reodite org</a>.
  </p>

  <div class="cards">
    {projects.map((p) => <EntryCard {...p.data} href={withBase(`/projects/${p.id}`)} />)}
  </div>

</Layout>

<style>
  h1 {
    font-size: calc(2.4rem * var(--display-scale, 1));
  }
  .intro {
    margin-top: 0.6rem;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
