---
import Layout from "@/layouts/Layout.astro";
import { jams } from "@/data/jams";
---

<Layout title="Jams" mode="games" description="Game jam entries by Libo Dev.">
  <h1>Game Jams</h1>
  <p class="muted intro">
    Weekend-sized games built against the clock. Jams are where half of my weirdest mechanics were born.
  </p>

  <div class="cards">
    {
      jams.map((jam) => (
        <article class="card jam">
          <div class="head">
            <h2>{jam.name}</h2>
            <span class="muted date">{jam.date}</span>
          </div>
          {jam.theme && (
            <p class="theme">
              Theme: <strong>{jam.theme}</strong>
            </p>
          )}
          <h3>{jam.game}</h3>
          {jam.result && <p class="accent">{jam.result}</p>}
          {jam.story && <p class="muted">{jam.story}</p>}
          <div class="links">
            {jam.links.map(({ label, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="text-link link">
                {label}
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Layout>

<style>
  h1 {
    font-size: calc(2.4rem * var(--display-scale, 1));
  }
  .intro {
    margin-top: 0.6rem;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .jam {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .head {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
  }
  h2 {
    font-size: calc(1.35rem * var(--display-scale, 1));
  }
  h3 {
    font-size: calc(1.1rem * var(--display-scale, 1));
    margin-top: 0.25rem;
  }
  .date {
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .theme {
    color: var(--accent-2);
    font-size: 0.9rem;
  }
  .theme::before {
    content: "[?] ";
    white-space: pre;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }
  .link {
    font-size: 0.9rem;
  }
  .link::before {
    content: "» ";
  }
</style>
