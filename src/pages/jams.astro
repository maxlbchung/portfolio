---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { getCollection } from "astro:content";
import { withBase } from "@/lib/url";

const jams = (await getCollection("jams")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Jams" mode="games" description="Game jam entries by Libo Dev.">
  <h1>Game Jams</h1>
  <p class="muted intro">Weekend-sized games built against the clock. Jams are where half of my weirdest mechanics were born.</p>
  <div class="cards">
    {jams.map((jam) => (
      <EntryCard title={jam.data.title} period={jam.data.period} blurb={`${jam.data.game}${jam.data.theme ? ` · Theme: ${jam.data.theme}` : ""}`} image={jam.data.image} href={withBase(`/jams/${jam.id}`)} />
    ))}
  </div>
</Layout>

<style>
  h1 { font-size: calc(2.4rem * var(--display-scale, 1)); }
  .intro { margin-top: 0.6rem; }
  .cards { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.75rem; }
</style>
