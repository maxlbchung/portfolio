---
import Layout from "@/layouts/Layout.astro";
import ModeToggle from "@/components/ModeToggle.astro";
import HeroAnimation from "@/components/HeroAnimation.astro";
import EntryCard from "@/components/EntryCard.astro";
import GitGraph from "@/components/GitGraph.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";
import { projects, games, stack } from "@/data/content";

const featuredProjects = projects.filter((p) => p.featured);
const featuredGames = games.filter((g) => g.featured);

const socials = [
  { href: site.socials.github, label: "github" },
  { href: site.socials.linkedin, label: "linkedin" },
  { href: site.socials.itch, label: "itch.io" },
  { href: site.socials.youtube, label: "youtube" },
];
---

<Layout mode="auto">
  <!-- ── Shared hero ─────────────────────────────────────────────────── -->
  <div class="hero">
    <div class="hero-text">
      <p class="hello">Hello, I'm</p>
      <h1 class="name">Max Li-Bo Chung</h1>
      <p class="subtitle muted">
        <span class="only-ai">{site.tagline.ai}</span>
        <span class="only-games">also known as <strong>{site.alias}</strong> — {site.tagline.games}</span>
      </p>

      <div class="socials">
        {
          socials.map(({ href, label }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="icon-link">
              {label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="hero-tri">
      <HeroAnimation />
    </div>
  </div>

  <!-- ── The big switch ──────────────────────────────────────────────── -->
  <ModeToggle />

  <!-- ── AI home ─────────────────────────────────────────────────────── -->
  <section class="mode-panel only-ai" aria-label="AI portfolio">
    <p class="bio">
      I build agent workflows and the scaffolding that makes LLMs actually good at things. Cognitive Systems
      (Computational Intelligence) student at UBC, currently researching LLM skill mutation with Prof. Anant Sahai at
      UC Berkeley — evolving skills against benchmarks with accuracy, tokens, and steps as the fitness signal.
    </p>
    <p class="bio">
      Lately that means agent orchestration for red teaming, browser-native LLMs, and academic tools used by UBC
      students.
    </p>

    <a href={withBase(site.resume)} target="_blank" rel="noopener noreferrer" class="btn resume-btn">
      ./resume.pdf
    </a>

    <h2 class="section-title">Technical Skills</h2>
    {
      Object.entries(stack).map(([group, items]) => (
        <div class="stack-group">
          <h3>{group}</h3>
          <div class="chips">
            {items.map(({ name }) => (
              <span class="chip">{name}</span>
            ))}
          </div>
        </div>
      ))
    }

    <div class="row-head">
      <h2 class="section-title">Featured Projects</h2>
      <a href={withBase("/projects")} class="text-link view-all">view all »</a>
    </div>
    <div class="cards">
      {featuredProjects.map((p) => <EntryCard {...p} />)}
    </div>

    <h2 class="section-title">GitHub Contributions</h2>
    <GitGraph username="maxlbchung" />
  </section>

  <!-- ── Games home ──────────────────────────────────────────────────── -->
  <section class="mode-panel only-games" aria-label="Games portfolio">
    <p class="bio">
      I've been making games since before I could drive — design, programming, art, 3D modeling, sound, and UI. Unity
      Certified Programmer, leader of six game dev teams, and builder of games that push on who gets to play: an
      arcade for blind players, a shooter you control with bare hands through a webcam.
    </p>
    <p class="bio">
      Everything playable lives on <a class="text-link" href={site.socials.itch} target="_blank" rel="noopener noreferrer">itch.io</a>{" "}
      and the devlogs land on <a class="text-link" href={site.socials.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>.
    </p>

    <div class="row-head">
      <h2 class="section-title">Featured Games</h2>
      <a href={withBase("/games")} class="text-link view-all">view all »</a>
    </div>
    <div class="cards">
      {featuredGames.map((g) => <EntryCard {...g} />)}
    </div>
  </section>
</Layout>

<style>
  .hero {
    align-items: center;
    display: grid;
    gap: 0.5rem 1.5rem;
    grid-template-columns: 1fr auto;
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-tri {
      display: none;
    }
  }

  .hello {
    font-size: 1.2rem;
  }

  .name {
    font-size: calc(clamp(2.6rem, 8vw, 3.4rem) * var(--display-scale, 1));
    margin: 0.1rem 0 0.4rem;
  }

  .subtitle {
    font-size: 1rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    margin-top: 1rem;
  }

  .bio {
    margin-bottom: 0.9rem;
  }

  .resume-btn {
    margin-top: 0.5rem;
  }

  .stack-group {
    margin-top: 0.9rem;
  }
  .stack-group h3 {
    font-size: calc(1.1rem * var(--display-scale, 1));
    margin-bottom: 0.4rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.6rem;
  }

  .row-head {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
  }
  .view-all {
    white-space: nowrap;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }
</style>
