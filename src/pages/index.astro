---
import Layout from "@/layouts/Layout.astro";
import ModeToggle from "@/components/ModeToggle.astro";
import EntryCard from "@/components/EntryCard.astro";
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";
import { projects } from "@/data/projects";
import { games } from "@/data/games";
import { stack } from "@/data/experience";

const featuredProjects = projects.filter((p) => p.featured);
const featuredGames = games.filter((g) => g.featured);
---

<Layout mode="auto">
  <!-- ── Shared hero ─────────────────────────────────────────────────── -->
  <p class="hello">Hello, I'm</p>
  <h1 class="name">Max Li-Bo Chung</h1>
  <p class="subtitle muted">
    <span class="only-ai">{site.tagline.ai}</span>
    <span class="only-games">also known as <strong>{site.alias}</strong> — {site.tagline.games}</span>
  </p>

  <div class="socials">
    <a href={site.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="icon-link">
      <Icon name="simple-icons:github" size={22} aria-hidden="true" />
    </a>
    <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="icon-link">
      <Icon name="simple-icons:linkedin" size={22} aria-hidden="true" />
    </a>
    <a href={site.socials.itch} target="_blank" rel="noopener noreferrer" aria-label="itch.io" class="icon-link">
      <Icon name="simple-icons:itchdotio" size={22} aria-hidden="true" />
    </a>
    <a href={site.socials.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="icon-link">
      <Icon name="simple-icons:youtube" size={22} aria-hidden="true" />
    </a>
  </div>

  <!-- ── The big switch ──────────────────────────────────────────────── -->
  <ModeToggle />

  <!-- ── AI home ─────────────────────────────────────────────────────── -->
  <section class="mode-panel only-ai" aria-label="AI portfolio">
    <p class="bio">
      I build agent workflows and the scaffolding that makes LLMs actually good at things. Cognitive Systems
      (Computational Intelligence) student at UBC, currently researching LLM skill mutation with Prof. Anant Sahai at
      UC Berkeley — evolving skills against benchmarks with accuracy, tokens, and steps as the fitness signal.
    </p>
    <p class="bio">
      Lately that means agent orchestration for red teaming, browser-native LLMs, and academic tools used by UBC
      students.
    </p>

    <a href={withBase(site.resume)} target="_blank" rel="noopener noreferrer" class="btn resume-btn">
      <Icon name="carbon:document" size={18} aria-hidden="true" />
      <span>Resume</span>
      <Icon name="carbon:launch" size={14} aria-hidden="true" />
    </a>

    <h2 class="section-title">Technical Skills</h2>
    {
      Object.entries(stack).map(([group, items]) => (
        <div class="stack-group">
          <h3>{group}</h3>
          <div class="chips">
            {items.map(({ name, icon }) => (
              <span class="chip">
                <Icon name={icon} size={15} aria-hidden="true" />
                {name}
              </span>
            ))}
          </div>
        </div>
      ))
    }

    <div class="row-head">
      <h2 class="section-title">Featured Projects</h2>
      <a href={withBase("/projects")} class="text-link view-all">
        <span>View all</span>
        <Icon name="carbon:arrow-right" size={15} aria-hidden="true" />
      </a>
    </div>
    <div class="cards">
      {featuredProjects.map((p) => <EntryCard {...p} />)}
    </div>
  </section>

  <!-- ── Games home ──────────────────────────────────────────────────── -->
  <section class="mode-panel only-games" aria-label="Games portfolio">
    <p class="bio">
      I've been making games since before I could drive — design, programming, art, 3D modeling, sound, and UI. Unity
      Certified Programmer, leader of six game dev teams, and builder of games that push on who gets to play: an
      arcade for blind players, a shooter you control with bare hands through a webcam.
    </p>
    <p class="bio">
      Everything playable lives on <a class="text-link" href={site.socials.itch} target="_blank" rel="noopener noreferrer">itch.io</a>{" "}
      and the devlogs land on <a class="text-link" href={site.socials.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>.
    </p>

    <div class="row-head">
      <h2 class="section-title">Featured Games</h2>
      <a href={withBase("/games")} class="text-link view-all">
        <span>View all</span>
        <Icon name="carbon:arrow-right" size={15} aria-hidden="true" />
      </a>
    </div>
    <div class="cards">
      {featuredGames.map((g) => <EntryCard {...g} />)}
    </div>
  </section>
</Layout>

<style>
  .hello {
    font-size: 1.35rem;
  }

  .name {
    font-size: clamp(2.6rem, 8vw, 3.4rem);
    margin: 0.1rem 0 0.4rem;
  }

  .subtitle {
    font-size: 1.05rem;
  }

  .socials {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .bio {
    margin-bottom: 0.9rem;
  }

  .resume-btn {
    margin-top: 0.5rem;
  }

  .stack-group {
    margin-top: 0.9rem;
  }
  .stack-group h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .row-head {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
  }
  .view-all {
    align-items: center;
    display: inline-flex;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
