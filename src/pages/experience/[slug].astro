---
import { getCollection, render } from "astro:content";
import EntryDetailPage from "@/components/EntryDetailPage.astro";
export async function getStaticPaths() { return (await getCollection("experience")).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props; const { Content } = await render(entry);
---
<EntryDetailPage entry={entry.data} mode="ai" backPath="/experience" backLabel="Experience">
  <Content />
</EntryDetailPage>
