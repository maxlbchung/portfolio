---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { getCollection } from "astro:content";
import { withBase } from "@/lib/url";

const posts = (await getCollection("diary")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout title="Dev Diary" mode="ai" description="Notes on AI projects, research, and building things.">
  <h1>Dev Diary</h1>
  <p class="muted intro">Notes on research, agents, and whatever I'm building this week.</p>
  <div class="cards">
    {posts.map((post) => <EntryCard {...post.data} href={withBase(`/dev-diary/${post.id}`)} />)}
  </div>
</Layout>

<style>
  h1 { font-size: calc(2.4rem * var(--display-scale, 1)); }
  .intro { margin-top: 0.6rem; }
  .cards { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1.75rem; }
</style>
