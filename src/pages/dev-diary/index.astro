---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "@/lib/url";

const posts = (await getCollection("diary")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Layout title="Dev Diary" mode="ai" description="Notes on AI projects, research, and building things.">
  <h1>Dev Diary</h1>
  <p class="muted intro">Notes on research, agents, and whatever I'm building this week.</p>

  <div class="posts">
    {
      posts.map((post) => (
        <a class="card post" href={withBase(`/dev-diary/${post.id}`)}>
          <div class="head">
            <h2>{post.data.title}</h2>
            <span class="muted date">{fmt(post.data.date)}</span>
          </div>
          {post.data.summary && <p class="muted">{post.data.summary}</p>}
          {post.data.tags && (
            <div class="chips">
              {post.data.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </div>
</Layout>

<style>
  h1 {
    font-size: calc(2.4rem * var(--display-scale, 1));
  }
  .intro {
    margin-top: 0.6rem;
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .post {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color var(--transition-quick), transform var(--transition-quick);
  }
  .post:hover {
    border-color: var(--text);
  }
  .post:hover h2::after {
    content: " «";
  }
  .head {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: space-between;
  }
  h2 {
    font-size: calc(1.25rem * var(--display-scale, 1));
  }
  .date {
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
