---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";
import { games } from "@/data/content";

const gameLinks = (links: (typeof games)[number]["links"]) =>
  links?.map((link) => ({
    ...link,
    label: link.url.includes("itch.io")
      ? "Play on Itch"
      : link.url.includes("chess-vc")
        ? "Play on Chess-vc"
        : link.label,
  }));
---

<Layout title="Games" mode="games" description="Games by Libo Dev — from an arcade for blind players to hand-tracked shooters.">
  <h1>Games</h1>
  <p class="muted intro">
    Some games I've shipped as <strong>{site.alias}</strong> — most of it playable in the browser.
  </p>

  <div class="cards">
    {games.map((g) => <EntryCard {...g} links={gameLinks(g.links)} />)}
  </div>

  <a href={site.socials.itch} target="_blank" rel="noopener noreferrer" class="btn more">
    <Icon name="simple-icons:itchdotio" size={15} aria-hidden="true" />
    <span>Browse all games</span>
  </a>
</Layout>

<style>
  h1 {
    font-size: calc(2.4rem * var(--display-scale, 1));
  }
  .intro {
    margin-top: 0.6rem;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
