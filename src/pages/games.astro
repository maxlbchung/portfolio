---
import Layout from "@/layouts/Layout.astro";
import EntryCard from "@/components/EntryCard.astro";
import { Icon } from "astro-icon/components";
import { site } from "@/data/site";
import { games } from "@/data/games";
---

<Layout title="Games" mode="games" description="Games by Libo Dev — from an arcade for blind players to hand-tracked shooters.">
  <h1>Games</h1>
  <p class="muted intro">
    Everything I've shipped as <strong>{site.alias}</strong> — most of it playable in the browser on <a class="text-link" href={site.socials.itch} target="_blank" rel="noopener noreferrer">itch.io</a>.
  </p>

  <div class="cards">
    {games.map((g) => <EntryCard {...g} />)}
  </div>

  <a href={site.socials.itch} target="_blank" rel="noopener noreferrer" class="btn more">
    <Icon name="simple-icons:itchdotio" size={16} aria-hidden="true" />
    <span>All games on itch.io</span>
  </a>
</Layout>

<style>
  h1 {
    font-size: 2.4rem;
  }
  .intro {
    margin-top: 0.6rem;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .more {
    margin-top: 1.5rem;
  }
</style>
