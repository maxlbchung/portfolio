---
import "@fontsource/vt323";
import "@fontsource-variable/space-grotesk";
import "@/styles/theme.css";
import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import IntroGrid from "@/components/IntroGrid.astro";
import ModeSweep from "@/components/ModeSweep.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  title?: string;
  description?: string;
  /**
   * "ai" | "games"  → this page belongs to one mode; visiting it switches the
   *                   whole site into that mode (and theme) before first paint.
   * "auto"          → the page (home) respects the visitor's stored mode.
   */
  mode?: "ai" | "games" | "auto";
  class?: string;
}

const {
  title,
  description = "Max Li-Bo Chung — AI developer & game developer.",
  mode = "auto",
  class: className,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — AI × Games`;
---

<!doctype html>
<html lang="en" data-mode="ai" class="intro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <!--
      Mode resolution — runs before first paint to avoid a theme flash.
      Pages with a fixed mode force it (and persist it); the home page
      restores the visitor's last choice, defaulting to "ai".
      Client-side navigations are handled in the astro:after-swap listener
      below, since this inline script only runs on full page loads.
    -->
    <script is:inline data-mode={mode}>
      (() => {
        document.documentElement.classList.add("js");
        const forced = document.currentScript.dataset.mode;
        let m = forced !== "auto" ? forced : null;
        if (!m) {
          try {
            m = localStorage.getItem("mode");
          } catch {}
        }
        if (m !== "ai" && m !== "games") m = "ai";
        document.documentElement.dataset.mode = m;
        try {
          localStorage.setItem("mode", m);
        } catch {}
      })();
    </script>
  </head>
  <body data-page-mode={mode}>
    <Navbar />
    <main class={className}>
      <slot />
    </main>
    <Footer />
    <!-- full-screen FX: page-open grid reveal + mode-swap conversion wave -->
    <IntroGrid />
    <ModeSweep />
  </body>
</html>

<style>
  main {
    margin: 0 auto;
    max-width: var(--content-width);
    padding: calc(var(--nav-height) + 3rem) 1.25rem 4rem;
  }
</style>

<script>
  // ── Mode resolution after client-side navigation ─────────────────────
  // astro:after-swap fires before the new page paints. The swapped-in <html>
  // carries the static data-mode="ai" and class="intro" from the server, so
  // re-resolve the mode and drop the intro (the grid intro only plays on
  // full loads). Games mode keeps the built-in view-transition fade; AI
  // mode additionally types the page title out, terminal-style.
  let typeTimer: ReturnType<typeof setTimeout> | undefined;
  const typeHeading = () => {
    clearTimeout(typeTimer);
    if (document.documentElement.dataset.mode !== "ai") return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const h1 = document.querySelector<HTMLElement>("main h1");
    if (!h1 || h1.childElementCount > 0) return; // plain-text titles only
    const full = h1.textContent ?? "";
    if (!full) return;
    h1.classList.add("typing");
    let i = 0;
    const step = () => {
      i++;
      h1.textContent = full.slice(0, i);
      if (i < full.length) typeTimer = setTimeout(step, 36);
      else h1.classList.remove("typing");
    };
    h1.textContent = "";
    typeTimer = setTimeout(step, 60);
  };

  document.addEventListener("astro:after-swap", () => {
    const html = document.documentElement;
    html.classList.remove("intro");
    html.classList.add("js");
    const forced = document.body.dataset.pageMode;
    let m: string | null = forced !== "auto" ? (forced ?? null) : null;
    if (!m) {
      try {
        m = localStorage.getItem("mode");
      } catch {}
    }
    if (m !== "ai" && m !== "games") m = "ai";
    html.dataset.mode = m;
    try {
      localStorage.setItem("mode", m);
    } catch {}
    typeHeading();
  });
</script>
