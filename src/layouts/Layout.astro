---
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/vt323";
import "@fontsource/share-tech-mono";
import "@fontsource-variable/space-grotesk";
import "@/styles/theme.css";
import "@/styles/global.css";

import { ClientRouter } from "astro:transitions";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ModeSweep from "@/components/ModeSweep.astro";
import PageScrollbar from "@/components/PageScrollbar.astro";
import { site } from "@/data/site";
import { withBase } from "@/lib/url";
import { buildId } from "@/lib/build";

interface Props {
  title?: string;
  description?: string;
  /**
   * "ai" | "games"  → this page belongs to one mode; visiting it switches the
   *                   whole site into that mode (and theme) before first paint.
   * "auto"          → the page (home) respects the visitor's stored mode.
   */
  mode?: "ai" | "games" | "auto";
  class?: string;
}

const {
  title,
  description = "LiboDev's portfolio",
  mode = "auto",
  class: className,
} = Astro.props;

const pageTitle = title ? `${title} · LiboDev` : "LiboDev";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const previewImageUrl = new URL(withBase("/images/site-preview.png"), Astro.site);
---

<!doctype html>
<html lang="en" data-mode="ai" class="boot">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Opt out of indexing and snippets even when a crawler ignores robots.txt. -->
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <link rel="icon" type="image/svg+xml" href={withBase("/images/favicon.svg")} data-dance-favicon />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Pixel-art character from the LiboDev portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content="Pixel-art character from the LiboDev portfolio" />
    <meta name="x-build" content={buildId} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <!--
      Mode resolution — runs before first paint to avoid a theme flash.
      Pages with a fixed mode force it (and persist it); the home page
      restores the visitor's last choice, defaulting to "ai".
      Client-side navigations are handled in the astro:after-swap listener
      below, since this inline script only runs on full page loads.
    -->
    <script is:inline data-mode={mode}>
      (() => {
        document.documentElement.classList.add("js");
        const forced = document.currentScript.dataset.mode;
        let m = forced !== "auto" ? forced : null;
        if (!m) {
          try {
            m = localStorage.getItem("mode");
          } catch {}
        }
        if (m !== "ai" && m !== "games") m = "ai";
        document.documentElement.dataset.mode = m;
        try {
          localStorage.setItem("mode", m);
        } catch {}
      })();
    </script>
  </head>
  <body data-page-mode={mode}>
    <Navbar />
    <main class={className}>
      <slot />
    </main>
    <Footer />
    <PageScrollbar />
    <!-- full-screen FX: the mode-swap conversion wave -->
    <ModeSweep />
  </body>
</html>

<style>
  main {
    margin: 0 auto;
    max-width: var(--content-width);
    padding: calc(var(--nav-height) + 3rem) 1.25rem 4rem;
  }
</style>

<script>
  // Favicon animation is driven from the same hand-authored dance frames as
  // the hero. Replacing the link each tick avoids browser GIF-favicon caching.
  import { fps, palette, frames } from "@/data/hero-animation";

  let favicon = document.querySelector<HTMLLinkElement>("link[data-dance-favicon]");
  if (favicon && frames.length > 1) {
    const grids = frames.map((frame) => {
      const lines = frame.split("\n");
      if (lines[0] === "") lines.shift();
      while (lines.length && lines[lines.length - 1]!.trim() === "") lines.pop();
      return lines;
    });
    const height = Math.max(...grids.map((grid) => grid.length));
    const width = Math.max(...grids.flat().map((line) => line.length));
    const canvas = document.createElement("canvas");
    canvas.width = width;
    canvas.height = height;
    const context = canvas.getContext("2d");
    let frameIndex = 0;
    let faviconTimer: number | undefined;

    const drawFavicon = () => {
      if (!context || !favicon) return;
      const grid = grids[frameIndex % grids.length]!;
      context.fillStyle = "#000000";
      context.fillRect(0, 0, width, height);
      grid.forEach((line, y) => {
        [...line].forEach((character, x) => {
          const color = palette[character]?.color;
          if (color) {
            context.fillStyle = color;
            context.fillRect(x, y, 1, 1);
          }
        });
      });

      const next = favicon.cloneNode(true) as HTMLLinkElement;
      next.type = "image/png";
      next.href = canvas.toDataURL("image/png");
      favicon.replaceWith(next);
      favicon = next;
      frameIndex++;
    };

    drawFavicon();
    // Tab chrome repaints favicons much less reliably than page content at
    // 8fps, so give each dance pose enough time to be visibly painted.
    const faviconFrameDelay = Math.max(300, 1000 / fps);
    const startFaviconAnimation = () => {
      if (faviconTimer === undefined) faviconTimer = window.setInterval(drawFavicon, faviconFrameDelay);
    };
    const stopFaviconAnimation = () => {
      if (faviconTimer !== undefined) {
        window.clearInterval(faviconTimer);
        faviconTimer = undefined;
      }
    };
    const resumeFaviconAnimation = () => {
      frameIndex = 0;
      drawFavicon();
      startFaviconAnimation();
    };
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopFaviconAnimation();
      else resumeFaviconAnimation();
    });
    window.addEventListener("pageshow", resumeFaviconAnimation);
    if (!document.hidden) startFaviconAnimation();
  }

  // ── Mode resolution after client-side navigation ─────────────────────
  // astro:after-swap fires before the new page paints. The swapped-in <html>
  // carries the static data-mode="ai" from the server, so re-resolve the
  // mode. Games mode keeps the built-in view-transition fade; AI mode
  // additionally types the page title out, terminal-style.
  let typeTimer: ReturnType<typeof setTimeout> | undefined;
  const typeHeading = () => {
    clearTimeout(typeTimer);
    if (document.documentElement.dataset.mode !== "ai") return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const h1 = document.querySelector<HTMLElement>("main h1");
    if (!h1 || h1.childElementCount > 0) return; // plain-text titles only
    const full = h1.textContent ?? "";
    if (!full) return;
    h1.classList.add("typing");
    let i = 0;
    const step = () => {
      i++;
      h1.textContent = full.slice(0, i);
      if (i < full.length) typeTimer = setTimeout(step, 36);
      else h1.classList.remove("typing");
    };
    h1.textContent = "";
    typeTimer = setTimeout(step, 60);
  };

  // full page loads: fade in (html.boot CSS) + type the title out
  typeHeading();

  // Detail pages remember the exact list position that opened them. Using
  // delegated handlers keeps this working after Astro client-side swaps.
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const detailLink = target.closest<HTMLAnchorElement>("[data-detail-link]");
    if (detailLink) {
      try {
        sessionStorage.setItem("portfolio:return-scroll", JSON.stringify({ path: location.pathname, y: window.scrollY }));
      } catch {}
      return;
    }
    const returnLink = target.closest<HTMLAnchorElement>("[data-return-link]");
    if (returnLink) {
      try {
        const saved = sessionStorage.getItem("portfolio:return-scroll");
        if (saved) sessionStorage.setItem("portfolio:restore-scroll", saved);
      } catch {}
    }
  });

  const restoreScroll = () => {
    try {
      const saved = JSON.parse(sessionStorage.getItem("portfolio:restore-scroll") ?? "null");
      if (!saved || saved.path !== location.pathname) return;
      sessionStorage.removeItem("portfolio:restore-scroll");
      requestAnimationFrame(() => requestAnimationFrame(() => window.scrollTo(0, saved.y)));
    } catch {}
  };
  restoreScroll();

  // back/forward-cache restores resurrect the page without re-running
  // scripts — re-arm the boot fade and retype so those replay it too
  window.addEventListener("pageshow", (e) => {
    if (!e.persisted) return;
    const html = document.documentElement;
    html.classList.remove("boot");
    requestAnimationFrame(() => {
      html.classList.add("boot");
      typeHeading();
    });
  });

  document.addEventListener("astro:after-swap", () => {
    const html = document.documentElement;
    const modeSwap = html.classList.contains("mode-swap");
    html.classList.remove("mode-swap");
    html.classList.remove("boot"); // the boot fade is for full loads only
    html.classList.add("js");
    const forced = document.body.dataset.pageMode;
    let m: string | null = forced !== "auto" ? (forced ?? null) : null;
    if (!m) {
      try {
        m = localStorage.getItem("mode");
      } catch {}
    }
    if (m !== "ai" && m !== "games") m = "ai";
    html.dataset.mode = m;
    try {
      localStorage.setItem("mode", m);
    } catch {}
    if (!modeSwap) typeHeading();
    restoreScroll();
  });

  // ── Stale-deploy guards ───────────────────────────────────────────────
  // GitHub Pages caches HTML for ~10 minutes and prefetchAll caches every
  // page eagerly, so right after a redeploy the browser can mix pages from
  // two builds. Two checks after each load/swap, each reloading at most
  // once per URL (a reload revalidates the document and picks up the
  // fresh deploy):
  //  1. a page older than the newest build id seen this session
  //  2. a stylesheet that failed to load (its hashed file was deleted by
  //     the redeploy), which would render the page as plain HTML
  const reloadOnce = () => {
    const key = `stale-reload:${window.location.pathname}`;
    try {
      if (sessionStorage.getItem(key) === "1") return; // no reload loops
      sessionStorage.setItem(key, "1");
    } catch {}
    window.location.reload();
  };

  document.addEventListener("astro:page-load", () => {
    const build = parseInt(
      document.querySelector('meta[name="x-build"]')?.getAttribute("content") ?? "",
      36,
    );
    if (Number.isFinite(build)) {
      let latest = 0;
      try {
        latest = parseInt(sessionStorage.getItem("latest-build") ?? "0", 36) || 0;
      } catch {}
      if (build > latest) {
        try {
          sessionStorage.setItem("latest-build", build.toString(36));
        } catch {}
      } else if (build < latest) {
        return reloadOnce(); // cached page from an older deploy
      }
    }

    const dead = [...document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')].some(
      (link) => {
        try {
          return !link.sheet;
        } catch {
          return false; // cross-origin sheets can't be inspected — assume fine
        }
      },
    );
    if (dead) reloadOnce();
  });
</script>
